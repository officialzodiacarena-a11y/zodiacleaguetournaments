              </div>
            )}

            <form onSubmit={handleSubmit} className="space-y-3">
              <div>
                <label className="block text-[11px] font-bold text-[#94A3B8] uppercase mb-1">
                  ชื่อแคมเปญ / แบนเนอร์ *
