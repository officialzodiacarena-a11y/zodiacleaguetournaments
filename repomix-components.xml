        setPoolId('');
        setWinningTeamId('');
      }
    } finally {
      setBusy(false);
      setConfirmOpen(false);
    }
  }

  return (
    <div className="rounded-xl bg-[#1A1C2E] p-5">
      <h3 className="mb-3 text-sm font-bold text-[#F9EDD8]">ตัดสินผล Pool (ADMIN / SUPER_ADMIN)</h3>
      <input
