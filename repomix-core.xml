        {/* 4. TODAY'S MATCHES */}
        <div className="mb-9">
          <div className="flex items-center gap-2.5 mb-3.5">
            <span className="text-[10px] font-bold tracking-widest text-[#E8B429] uppercase">
              การแข่งขัน
