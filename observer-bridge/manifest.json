{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "Zodiac Arena Observer Bridge",
    "author": "Zodiac Arena",
    "version": "0.1.0",
    "minimum-overwolf-version": "0.240.0",
    "description": "ยิง telemetry รายรอบ (เงิน/อาวุธ/เกราะ/Ult) จาก Overwolf GEP ของ Valorant เข้า Buy Phase HUD ของ Zodiac Arena — ตาม ADR-004 ติดตั้งเฉพาะเครื่อง Observer/Spectator เท่านั้น ห้ามผู้เล่นทั้ง 10 คนติดตั้งเด็ดขาด",
    "icon": "icons/icon.png",
    "icon_gray": "icons/icon.png",
    "window_icon": "icons/icon.png"
  },
  "permissions": ["GameInfo"],
  "data": {
    "game_events": [21640],
    "start_window": "controller",
    "windows": {
      "background": {
        "file": "background.html",
        "is_background_page": true
      },
      "controller": {
        "file": "index.html",
        "transparent": false,
        "resizable": true,
        "native_window": true,
        "show_in_taskbar": true,
        "size": { "width": 440, "height": 640 },
        "min_size": { "width": 380, "height": 480 }
      }
    }
  }
}
