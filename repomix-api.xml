        });

    } catch (err) {
        const message = err instanceof Error ? err.message : 'Internal Server Error';
        console.error('[/api/v1/tournament/circuit/award-weekly]', message);
        return NextResponse.json(
            { success: false, error: message },
            { status: 500 }
        );
    }
}
