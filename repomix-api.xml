        { error: { code: 'PLAYER_NOT_FOUND', message: 'ไม่พบโปรไฟล์ผู้เล่นของบัญชีนี้' } },
        { status: 404 }
      );
    }

    // 3. Permission Gate: Role Verification
    const { data: userRole, error: roleError } = await supabase
      .from('user_roles')
