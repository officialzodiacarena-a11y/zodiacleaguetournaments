-- -----------------------------------------------------------------------------
-- watch_heartbeats — log ทุก heartbeat เพื่อ audit/anti-abuse
-- -----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS public.watch_heartbeats (
    id                UUID PRIMARY KEY DEFAULT gen_random_uuid(),
