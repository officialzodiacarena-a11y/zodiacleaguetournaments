    if (gameAccount.verification_status !== 'VERIFIED') {
      return NextResponse.json(
        { error: { code: 'INVALID_STATE_TRANSITION', message: 'สามารถเพิกถอนได้เฉพาะบัญชีที่มีสถานะ VERIFIED เท่านั้น' } },
        { status: 409 }
      );
    }

    const nowIso = new Date().toISOString();

    // ตั้ง verification_status = 'REVOKED' เท่านั้น — trigger clean_revoked_game_account()
    // ในไมเกรชัน T4.0 จะเคลียร์ rso tokens และสลัก players.unverified_data = TRUE ให้อัตโนมัติ
    const { data: updated, error: updateError } = await adminSupabase
      .from('game_accounts')
      .update({
        verification_status: 'REVOKED',
        rejection_reason: reason,
        reviewed_at: nowIso,
        verified_by: admin.id,
      })
      .eq('id', gameAccountId)
      .select('id, player_id, verification_status')
      .single();

    if (updateError) {
      return NextResponse.json({ error: { code: 'UPDATE_FAILED', message: updateError.message } }, { status: 500 });
    }

    await adminSupabase.from('audit_logs').insert({
      actor_id: admin.id,
      action: 'REVOKE',
      entity_type: 'game_accounts',
      entity_id: gameAccountId,
      reason,
      after_data: { verification_status: 'REVOKED', player_id: gameAccount.player_id, unverified_data: true },
    });

    await adminSupabase.channel(`player-presence-${gameAccount.player_id}`).send({
      type: 'broadcast',
      event: 'verification_updated',
      payload: { player_id: gameAccount.player_id, verification_status: 'REVOKED', reason },
    });

    return NextResponse.json({
      success: true,
      message: 'เพิกถอนสถานะการตรวจสอบเรียบร้อย ผู้เล่นถูกปรับลดสถานะและตั้งค่า unverified_data = true',
      data: { ...updated, unverified_data: true },
    });
  } catch (error: unknown) {
    const message = error instanceof Error ? error.message : 'Internal Server Error';
    return NextResponse.json({ error: { code: 'SERVER_ERROR', message } }, { status: 500 });
  }
}
